37895>>>    Procedure SetActionButtons
37898>>>        tWebNavigateData NavigateData
37898>>>        tWebNavigateData NavigateData
37898>>>        Boolean bHasRecord
37898>>>        Handle hoDD
37898>>>
37898>>>        Get Server to hoDD
37899>>>        Get GetNavigateData to NavigateData
37900>>>        Get HasRecord of hoDD to bHasRecord
37901>>>
37901>>>        // let's hide all buttons and then Show the ones we want
37901>>>        WebSet pbRender of oEditBtn to False
37902>>>        WebSet pbRender of oSaveBtn to False
37903>>>        WebSet pbRender of oCancelChangesBtn to False
37904>>>        WebSet pbRender of oDeleteBtn to False
37905>>>
37905>>>        If (NavigateData.bReadOnly) Begin
37907>>>            WebSet pbRender of oEditBtn to True
37908>>>        End
37908>>>>
37908>>>        Else Begin
37909>>>            WebSet pbRender of oSaveBtn to True
37910>>>            WebSet pbRender of oCancelChangesBtn to True
37911>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37912>>>        End
37912>>>>
37912>>>    End_Procedure
37913>>>
